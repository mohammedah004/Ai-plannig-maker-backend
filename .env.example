PORT=5000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Supabase Service Role Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication Secrets
AUTH_SECRET=your-nextauth-secret-here
INTERNAL_API_SECRET=your-distinct-internal-service-secret-hex-or-base64

# Automated Health Monitoring & Webhook Alerting (Discord / Slack / Telegram / Generic)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Google Gemini AI Configuration
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Or multiple rotated keys: GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth2 Credentials for Google Sheets & Drive Export
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_SHEETS_OWNER_REFRESH_TOKEN=1//your-google-oauth-owner-refresh-token
